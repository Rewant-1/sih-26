        <mxCell id="t1_card1" value="&lt;b style='font-size: 13px;'&gt;Learner Hub &amp;amp; Radar&lt;/b&gt;&lt;hr style='border-color: #D8921E;'&gt;&lt;div style='font-size: 11px; text-align: left;'&gt;• ISS AD · SSO · JSO Personas&lt;br&gt;• 29-Skill Polar Radar Chart&lt;br&gt;• Prioritized Gap Diagnostics&lt;br&gt;• 1-Click Course Enrolment&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#142446;strokeColor=#D8921E;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="tier1_group">
