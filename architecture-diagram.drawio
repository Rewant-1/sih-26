        <mxCell id="t2_card1" value="&lt;b style='font-size: 12px; color: #142446;'&gt;FRAC Gap Engine (R1)&lt;/b&gt;&lt;hr&gt;&lt;div style='font-size: 10.5px; text-align: left; color: #475A6F;'&gt;• &amp;Delta; = max(0, Req &amp;minus; Assessed)&lt;br&gt;• Priority = &amp;Delta; &amp;times; W_dom &amp;times; C_cadre&lt;br&gt;• Temporal Decay: exp(&amp;minus;&amp;lambda;&amp;Delta;t)&lt;br&gt;• Role Deficit Index (RDI)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF9F6;strokeColor=#142446;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="tier2_group">
          <mxGeometry x="25" y="45" width="235" height="110" as="geometry" />
