        <mxCell id="header_box" value="&lt;b style='font-size: 20px; color: #142446;'&gt;कर्मसारथी | KARMASARTHI — Production System Architecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 12px; color: #475A6F;'&gt;AI-Enabled Skill Intelligence &amp; Capacity Building Platform for the Indian Official Statistical System (MoSPI / DIID — SIH26101)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7C2BA;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
