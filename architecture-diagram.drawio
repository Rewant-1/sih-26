        <mxCell id="t2_card2" value="&lt;b style='font-size: 12px; color: #142446;'&gt;Dual Recommender (R2)&lt;/b&gt;&lt;hr&gt;&lt;div style='font-size: 10.5px; text-align: left; color: #475A6F;'&gt;• +1 Single-Step Level Progression&lt;br&gt;• iGOT Karmayogi + NSSTA Catalog&lt;br&gt;• Cadre Suitability Multipliers&lt;br&gt;• Explainable Pedagogical Reason&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF9F6;strokeColor=#142446;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="tier2_group">
